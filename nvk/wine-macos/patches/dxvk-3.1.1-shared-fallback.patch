diff --git a/src/dxvk/dxvk_fence.cpp b/src/dxvk/dxvk_fence.cpp
index 8485c40..668e795 100644
--- a/src/dxvk/dxvk_fence.cpp
+++ b/src/dxvk/dxvk_fence.cpp
@@ -7,6 +7,12 @@ namespace dxvk {
           DxvkDevice*           device,
     const DxvkFenceCreateInfo&  info)
   : m_vkd(device->vkd()), m_info(info) {
+    // Shared textures can fall back to local storage when Win32 sharing is
+    // unavailable. Their optional keyed mutex must not call a missing exporter.
+    if (info.sharedType != VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_FLAG_BITS_MAX_ENUM
+     && !device->features().khrExternalSemaphoreWin32)
+      throw DxvkError("DxvkFence: Win32 semaphore sharing is not supported");
+
     VkSemaphoreTypeCreateInfo typeInfo = { VK_STRUCTURE_TYPE_SEMAPHORE_TYPE_CREATE_INFO };
     typeInfo.semaphoreType = VK_SEMAPHORE_TYPE_TIMELINE;
     typeInfo.initialValue = info.initialValue;
diff --git a/src/dxvk/dxvk_image.cpp b/src/dxvk/dxvk_image.cpp
index 3b5b739..ab0ded9 100644
--- a/src/dxvk/dxvk_image.cpp
+++ b/src/dxvk/dxvk_image.cpp
@@ -334,7 +334,10 @@ namespace dxvk {
     allocationInfo.resourceCookie = cookie();
     allocationInfo.properties = m_properties;
     allocationInfo.mode = mode;
-    allocationInfo.handleType = m_info.sharing.type;
+    // A rejected sharing request creates ordinary local storage. Do not try to
+    // export its allocation through an unavailable Win32 memory-handle entry.
+    if (m_shared)
+      allocationInfo.handleType = m_info.sharing.type;
-
+
     if (m_info.transient)
       allocationInfo.mode.set(DxvkAllocationMode::NoDedicated);
